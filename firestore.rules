rules_version = '2';

// ⚠️ RÈGLES DE DÉVELOPPEMENT : lecture/écriture ouvertes à tous.
// L'application n'a pas d'authentification : n'importe qui connaissant l'ID du projet
// peut lire et modifier les données. À restreindre avant toute mise en production
// (ex. Firebase Auth + `allow read, write: if request.auth != null;`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{carId} {
      allow read, write: if true;
    }
    match /rentals/{rentalId} {
      allow read, write: if true;
    }
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
