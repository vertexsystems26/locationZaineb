# Copiez ce fichier en .env.local puis renseignez les valeurs de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Configuration du SDK).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optionnel : Google Analytics (chargé seulement côté navigateur et si supporté)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
